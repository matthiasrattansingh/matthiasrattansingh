# Copy to .env (git-ignored) and fill in. Never commit real keys.
# Secrets are read only by the server process and are never sent to the browser.

# --- HTTP server ---
# Bind address. Keep 127.0.0.1 unless you put the app behind auth.
HOST=127.0.0.1
PORT=8787
# Optional HTTP Basic auth for the whole app ("user:password"). Strongly recommended if HOST is not loopback.
# APP_BASIC_AUTH=trader:change-me

# --- Storage ---
# Directory for the SQLite ledger (positions, orders, quotes, history). Defaults to ./data
# DATA_DIR=./data

# --- Market data (choose the provider in Settings; keys live only here) ---
# Databento (CME Globex MDP 3.0, dataset GLBX.MDP3). https://databento.com
# DATABENTO_API_KEY=

# Generic HTTP/JSON quote API (configure URL template and JSON paths in Settings).
# The key is injected server-side as a header or as {apiKey} in the URL template.
# CUSTOM_QUOTE_API_KEY=

# --- Fundamentals ---
# EIA Open Data API v2 key (free registration: https://www.eia.gov/opendata/register.php)
# EIA_API_KEY=

# FX reference rates come from Frankfurter (ECB reference rates, no key required).
# Override the base URL only if you self-host Frankfurter.
# FX_API_BASE=https://api.frankfurter.dev/v1
