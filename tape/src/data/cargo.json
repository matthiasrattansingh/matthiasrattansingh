        {
          "day": 3,
          "date": "2020-04-24",
          "type": "refinery_outage",
          "port": "rtm",
          "usd": -0.6,
          "text": "EU refiners cut runs; Rotterdam bids off"
        },
        {
          "day": 6,
          "date": "2020-04-29",
          "type": "weather_delay",
          "days": 1,
          "text": "Atlantic gale slows the voyage a day"
        }
      ],
      "why": [
        "In April 2020 demand fell faster than supply could stop, so prompt barrels had no buyer and the curve went into super-contango.",
        "Holding the cargo afloat (paying charter) and selling into the rebound beat dumping it in a full US Gulf."
      ],
      "concept": "cb-floating-storage",
      "source": "Benchmark: ICE Brent front-month settlements 21 Apr-8 May 2020 (real). Port basis modeled around reported spring-2020 US Gulf discounts; event dates match reported storage stress (EIA, Reuters).",
