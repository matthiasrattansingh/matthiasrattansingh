          "voyage": 2,
          "basis": {
            "start": -3.0,
            "end": -2.2,
            "noise": 0.25
          }
        },
        {
          "id": "rtm",
          "name": "Rotterdam",
          "voyage": 13,
          "basis": {
            "start": -1.4,
            "end": -0.6,
            "noise": 0.2
          }
        }
      ],
      "decisions": [
        0,
