        8
      ],
      "events": [
        {
          "day": 0,
          "date": "2020-04-21",
          "type": "pipeline_outage",
          "port": "hou",
          "usd": -1.5,
          "widen": 0.3,
          "text": "Day after negative WTI: Gulf glutted"
        },
        {
          "day": 1,
          "date": "2020-04-22",
          "type": "port_congestion",
          "port": "hou",
          "days": 2,
          "text": "Houston tanks full; tankers queue"
        },
        {
          "day": 2,
          "date": "2020-04-23",
          "type": "distressed_seller",
          "port": "hou",
          "usd": -0.8,
          "buyers": 1,
          "line": "A VLCC is offering under you.",
          "text": "Stranded VLCC dumps crude at Houston"
